<?xml version="1.0" encoding="utf-8"?>
<!--
  到柠檬纸飞机服务器的连接一律 TLS（固定证书指纹或 CA 校验），不受这里影响。
  允许明文 http 只为了在 App 内置浏览器里打开运行地址：用服务器的局域网地址直连开发服务（如 http://192.168.1.10:5173），
  以及编辑器、终端网页经本机回环地址转发。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
